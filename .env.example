# Admin panel API base URL (no trailing slash).
#
# Local backend:
VITE_API_BASE_URL=http://localhost:5000/api/admin
#
# Production (Render) — Vercel -> Settings -> Environment Variables me ye value
# daalni hoti hai, kyunki `.env` git me commit nahi hota:
# VITE_API_BASE_URL=https://new-finance-back.onrender.com/api/admin
